<?php

declare(strict_types=1);

namespace Database\Seeders;

use Gsebastiao\LaravelMenu\Models\MenuItem;
use Illuminate\Database\Seeder;

/**
 * Menu de exemplo com vários níveis. Podes corrê-lo várias vezes: cada item
 * é identificado pelo `name`, por isso é atualizado em vez de duplicado.
 *
 * As rotas usadas ('dashboard', 'admin.users.index', ...) são só exemplos.
 * Enquanto não existirem no teu projeto, esses itens aparecem sem link.
 */
class MenuItemsSeeder extends Seeder
{
    public function run(): void
    {
        /** @var class-string<MenuItem> $model */
        $model = config('menu.model', MenuItem::class);

        $item = static fn (string $name, array $attributes): MenuItem => $model::query()
            ->updateOrCreate(['name' => $name], $attributes);

        // Dashboard (raiz, sem permissão: visível para todos)
        $item('dashboard', [
            'label' => 'Dashboard',
            'route' => 'dashboard',
            'icon'  => 'home',
            'order' => 1,
        ]);

        // Administração (grupo sem link, com permissão)
        $admin = $item('admin', [
            'label'      => 'Administração',
            'icon'       => 'shield',
            'order'      => 2,
            'permission' => 'admin.access',
        ]);

        $item('admin.users', [
            'parent_id'  => $admin->id,
            'label'      => 'Utilizadores',
            'route'      => 'admin.users.index',
            'icon'       => 'users',
            'order'      => 1,
            'permission' => 'users.view',
            'badge'      => 'novo',
        ]);

        $item('admin.roles', [
            'parent_id'  => $admin->id,
            'label'      => 'Perfis',
            'route'      => 'admin.roles.index',
            'icon'       => 'key',
            'order'      => 2,
            'permission' => 'roles.view',
        ]);

        // Separador dentro de Administração
        $item('admin.sep.1', [
            'parent_id'    => $admin->id,
            'label'        => '—',
            'order'        => 3,
            'is_separator' => true,
        ]);

        // Terceiro nível: Administração > Definições > Sistema
        $settings = $item('admin.settings', [
            'parent_id'  => $admin->id,
            'label'      => 'Definições',
            'icon'       => 'cog',
            'order'      => 4,
            'permission' => 'settings.view',
        ]);

        $item('admin.settings.system', [
            'parent_id'  => $settings->id,
            'label'      => 'Sistema',
            'route'      => 'admin.settings.system',
            'icon'       => 'server',
            'order'      => 1,
            'permission' => 'settings.system',
            'params'     => ['section' => 'general'],
        ]);

        // Link externo, aberto num novo separador
        $item('docs', [
            'label'  => 'Documentação',
            'route'  => 'https://github.com/gsebastiao/laravel-menu',
            'icon'   => 'book',
            'order'  => 3,
            'target' => '_blank',
        ]);
    }
}
